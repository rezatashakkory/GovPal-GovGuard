# GovPal-GovGuard environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Ollama (local LLM server) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=mistral

# ── Storage paths ─────────────────────────────────────────────────────────────
VECTOR_DB_PATH=./data/chroma_db
AUDIT_DB_PATH=./data/audit.db

# ── GDPR audit log retention ──────────────────────────────────────────────────
LOG_RETENTION_DAYS=90

# ── JWT authentication ────────────────────────────────────────────────────────
# IMPORTANT: change JWT_SECRET to a long random string before any deployment!
JWT_SECRET=govguard-dev-secret-CHANGE-IN-PRODUCTION
JWT_EXPIRE_MINUTES=30

# ── Demo user passwords (override defaults) ───────────────────────────────────
ANALYST_PW=Analyst123!
MANAGER_PW=Manager123!
PARTNER_PW=Partner123!
